{
  "backend": "hyworld15",
  "method": "cst_t",
  "seed": 2034,
  "validation_fraction": 0.2,
  "split_metadata_key": "dataset_split",
  "split_train_value": "train",
  "split_validation_value": "heldout",
  "split_group_by": "prompt",
  "batch_size": 1,
  "learning_rate": 0.00001,
  "learning_rate_scheduler": "cosine",
  "minimum_learning_rate": 0.000001,
  "weight_decay": 0.0001,
  "gradient_clip": 1.0,
  "max_steps": 4000,
  "validation_interval": 200,
  "checkpoint_interval": 50,
  "metrics_log_interval": 20,
  "wandb_project": "actionsplice",
  "num_workers": 0,
  "base_channels": 128,
  "condition_channels": 256,
  "max_rollout_age": 0,
  "transport_role": "action_hm_state",
  "use_temporal_suffix_mask": true,
  "jump_horizons": [0],
  "receipt_steps": [1, 2, 3],
  "source_branch": "old",
  "target_branch": "new",
  "use_cached_prediction": false,
  "target_parameterization": "state",
  "loss_weights": {
    "lambda_state": 1.0,
    "lambda_residual": 0.0,
    "lambda_lpips": 0.05,
    "lambda_temporal": 0.1,
    "lambda_history_boundary": 0.1,
    "lambda_mid": 0.1
  },
  "decoded_latent_crop_height": 20,
  "decoded_latent_crop_width": 32,
  "decoded_history_latent_frames": 1,
  "decoded_prediction_latent_frames": 4,
  "decoded_event_rgb_frames": 16,
  "decoded_lpips_frame_count": 4,
  "decoded_lpips_height": 96,
  "decoded_lpips_width": 160,
  "decoded_validation_batch_limit": 6,
  "decoded_max_validation_nmse": 0.003,
  "decoded_backbone": "official_hyworld15",
  "decoded_hyworld_root": "<PATH_TO_HY_WORLDPLAY>",
  "decoded_hyworld_model_path": "<PATH_TO_HUNYUANVIDEO_1_5>",
  "balance_training_by": ["receipt_step", "intra_chunk_offset", "action_transition"],
  "ema_decay": 0.999,
  "required_best_validation_nmse": 0.003,
  "benchmark_warmup": 10,
  "benchmark_repetitions": 50
}
